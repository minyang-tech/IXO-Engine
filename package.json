{
  "name": "ixo-engine",
  "version": "0.1.0",
  "description": "IXO Engine - no-code visual node builder based on Electron and React Flow.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "start": "electron .",
    "build:renderer": "vite build",
    "build": "npm run build:renderer",
    "preview": "vite preview"
  },
  "keywords": [
    "electron",
    "react",
    "reactflow",
    "no-code",
    "node-editor"
  ],
  "author": "MinyangTech",
  "license": "SEE LICENSE IN LICENSE.md",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.3",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "7zip-bin": "^5.2.0",
    "archiver": "^7.0.1",
    "concurrently": "^9.0.1",
    "electron": "^31.7.7",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  }
}
