{
  "name": "ixo-engine",
  "version": "1.0.0",
  "description": "IXO Engine - Developed by Minyang Tech",
  "author": "Whoasked (Minyang Tech)",
  "main": "electron/main.js",
  "license": "MYT Standard EULA",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "start": "electron .",
    "build:renderer": "node scripts/build-renderer.cjs",
    "build:electron": "electron-builder --win --x64 --config.directories.output=dist_release_final",
    "build:linux": "electron-builder --linux zip --x64 --config.directories.output=dist_release_linux_final",
    "build:mac": "electron-builder --mac dmg zip --x64 --arm64 --config.directories.output=dist_release_mac_final",
    "build:all": "npm run build:renderer && electron-builder --win --linux zip --x64 --config.directories.output=dist_release_all",
    "build": "npm run build:renderer && npm run build:electron",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.minyangtech.ixoengine",
    "productName": "IXO Engine",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist_ship/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "IXO Logo.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "IXO Logo.png"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^0.0.55",
    "reactflow": "^11.10.4",
    "7zip-bin": "^5.2.0",
    "archiver": "^7.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  }
}
