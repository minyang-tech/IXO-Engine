{
  "name": "ixo-engine",
  "version": "1.0.0",
  "description": "IXO Engine - Developed by Minyang Tech",
  "author": {
    "name": "민양테크",
    "email": "hhamstarrrrr@gmail.com"
  },
  "main": "electron/main.js",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/minyang-tech/IXO-Engine.git"
  },
  "bugs": {
    "url": "https://github.com/minyang-tech/IXO-Engine/issues"
  },
  "homepage": "https://github.com/minyang-tech/IXO-Engine#readme",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "start": "electron .",
    "build:renderer": "node scripts/build-renderer.cjs",
    "build:electron": "electron-builder --win --x64 --config.directories.output=release/windows",
    "build:linux": "electron-builder --linux AppImage deb zip --x64 --config.directories.output=release/linux",
    "build:mac": "electron-builder --mac dmg zip --x64 --arm64 --config.directories.output=release/macos",
    "build:all": "npm run build:renderer && electron-builder --win nsis --linux AppImage deb zip --x64 --config.directories.output=release/all",
    "build": "npm run build:renderer && npm run build:electron",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.minyangtech.ixoengine",
    "productName": "IXO Engine",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/renderer/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/rcedit/bin/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "IXO Logo.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "IXO Logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^0.0.55",
    "reactflow": "^11.10.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.0.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "vite": "^8.0.13",
    "wait-on": "^8.0.1"
  }
}
